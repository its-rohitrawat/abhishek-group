---
import Arrow from './Arrow.astro';
import { audiences } from '../data/site';
---
<section class="section audiences" aria-labelledby="audiences-title">
  <div class="wrap">
    <header class="section-head">
      <p class="mono section-label">01 / Who we serve</p>
      <h2 id="audiences-title" class="display section-title">Built for the people who build, govern and drive.</h2>
      <p class="section-intro">From the factory line to the transport office to the end of the road, three groups rely on us every day.</p>
    </header>

    <ul class="tiles">
      {audiences.map((a) => (
        <li>
          <a class="tile" href="#contact">
            <span class="mono tile__no">{a.no}</span>
            <h3 class="tile__title">{a.title}</h3>
            <p class="tile__body">{a.body}</p>
            <span class="tile__cta mono">Talk to us <Arrow /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
  }
  .tiles li + li {
    border-left: 1px solid var(--line);
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 2rem clamp(1.25rem, 2.5vw, 2.25rem) 2.25rem;
    transition:
      background-color 280ms var(--ease-out),
      color 280ms var(--ease-out);
  }
  .tile__no {
    color: var(--muted);
    margin-bottom: clamp(2rem, 5vw, 4rem);
    transition: color 280ms var(--ease-out);
  }
  .tile__title {
    font-stretch: 118%;
    font-weight: 600;
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .tile__body {
    color: var(--muted);
    max-width: 36ch;
    transition: color 280ms var(--ease-out);
  }
  .tile__cta {
    margin-top: auto;
    padding-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover {
      background: var(--ink);
      color: var(--paper);
    }
    .tile:hover .tile__no,
    .tile:hover .tile__body {
      color: rgb(255 255 255 / 0.65);
    }
    .tile:hover .arrow {
      transform: translateX(4px);
    }
  }
  @media (max-width: 860px) {
    .tiles {
      grid-template-columns: 1fr;
    }
    .tiles li + li {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .tile__no {
      margin-bottom: 0.5rem;
    }
  }
</style>
