---
import Symbol from './Symbol.astro';
import Arrow from './Arrow.astro';
import { businesses } from '../data/site';
---
<section class="section businesses" id="businesses" aria-labelledby="businesses-title">
  <div class="wrap">
    <header class="section-head">
      <p class="mono section-label">02 / Our businesses</p>
      <h2 id="businesses-title" class="display section-title">Four businesses.<br />One vehicle's lifetime.</h2>
      <p class="section-intro">Each business owns a stage of the vehicle's life, and each carries its own colour across everything we make.</p>
    </header>

    <ol class="cards">
      {businesses.map((b) => (
        <li class="card" id={`biz-${b.key}`} data-key={b.key}>
          <span class="card__bar" aria-hidden="true"></span>
          <div class="card__top">
            <span class="mono card__stage">Stage {b.stageNo}<br /><strong>{b.stage}</strong></span>
            <Symbol class="card__symbol" />
          </div>
          <h3 class="card__name">{b.name}</h3>
          <p class="card__line">{b.line}</p>
          <ul class="card__tags" aria-label={`${b.name} products`}>
            {b.products.map((p) => <li class="mono">{p}</li>)}
          </ul>
          <div class="card__foot">
            <span class="mono card__partner">{b.partner}</span>
            <a class="link card__link" href="#partners" aria-label={`Explore ${b.name}`}>Explore <Arrow /></a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .businesses {
    background: var(--paper-2);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem 1.5rem 1.5rem;
    background: var(--paper);
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }
  .card__bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 6px;
    background: var(--accent);
    transition: height 320ms var(--ease-out);
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: clamp(1.5rem, 4vw, 3.5rem);
  }
  .card__stage {
    color: var(--muted);
    line-height: 1.6;
  }
  .card__stage strong {
    color: var(--ink);
    font-weight: 500;
  }
  .card__top :global(.card__symbol) {
    width: 44px;
    color: var(--accent);
    transition: transform 400ms var(--ease-out);
  }
  .card__name {
    font-stretch: 118%;
    font-weight: 600;
    font-size: clamp(1.375rem, 1.9vw, 1.625rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .card__line {
    color: var(--muted);
    font-size: 0.9875rem;
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .card__tags li {
    font-size: 0.65rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }
  .card__foot {
    margin-top: auto;
    padding-top: 1.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--line);
  }
  .card__partner {
    font-size: 0.65rem;
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .card__link {
    font-size: 0.7rem;
    border-bottom: 0;
    padding: 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover .card__bar {
      height: 10px;
    }
    .card:hover :global(.card__symbol) {
      transform: rotate(-10deg);
    }
  }
  @media (max-width: 1080px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
